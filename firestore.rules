rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Garante que a requisição venha de um usuário autenticado com e-mail corporativo Makita
    function isMakitaUser() {
      return request.auth != null && 
             (request.auth.token.email.matches('.*@makita[.]com[.]br$') || 
              request.auth.token.email.matches('.*@makitabr[.]onmicrosoft[.]com$'));
    }

    // 1. Coleção de Vínculos Protheus: leitura aberta para validação de vínculo no login; escrita apenas para Makita
    match /usuarios_protheus/{document} {
      allow read: if true;
      allow write: if isMakitaUser();
    }

    // 2. Coleção de Solicitações de Devolução (solicitacoes_devolucao)
    match /solicitacoes_devolucao/{document} {
      allow read, create, update, delete: if isMakitaUser();
    }

    // 3. Coleção de Ativos e Saldos (ativos_saldo)
    match /ativos_saldo/{document} {
      allow read, write: if isMakitaUser();
    }

    // 4. Coleção Raiz de NF-e Disponíveis (nfe_disponiveis)
    match /nfe_disponiveis/{document} {
      allow read, write: if isMakitaUser();
    }

    // 5. Coleção Hierárquica: promotores/{promotorId}/nfe_disponiveis/{document}
    match /promotores/{promotorId} {
      allow read, write: if isMakitaUser();
      
      match /{subcollection=**} {
        allow read, write: if isMakitaUser();
      }
    }
  }
}
